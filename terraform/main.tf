provider "mongodbatlas" {
  public_key  = var.atlas_public_key
  private_key = var.atlas_private_key
}

resource "random_password" "app_password" {
  length  = 24
  special = false
}

resource "random_password" "reader_password" {
  length  = 24
  special = false
}

locals {
  final_app_password    = var.app_password != "" ? var.app_password : random_password.app_password.result
  final_reader_password = var.reader_password != "" ? var.reader_password : random_password.reader_password.result

  # M0, M2, M5 are multi-tenant free/shared tiers requiring provider_name = "TENANT"
  is_shared_tier        = contains(["M0", "M2", "M5"], var.cluster_tier)
  provider_name         = local.is_shared_tier ? "TENANT" : var.cloud_provider
  backing_provider_name = local.is_shared_tier ? var.cloud_provider : null

  srv_host = replace(
    mongodbatlas_advanced_cluster.cluster.connection_strings[0].standard_srv,
    "mongodb+srv://",
    ""
  )
}

resource "mongodbatlas_project" "project" {
  name   = var.project_name
  org_id = var.atlas_org_id
}

resource "mongodbatlas_advanced_cluster" "cluster" {
  project_id   = mongodbatlas_project.project.id
  name         = var.cluster_name
  cluster_type = "REPLICASET"

  replication_specs {
    region_configs {
      electable_specs {
        instance_size = var.cluster_tier
      }
      provider_name         = local.provider_name
      backing_provider_name = local.backing_provider_name
      region_name           = var.region_name
      priority              = 7
    }
  }
}

resource "mongodbatlas_project_ip_access_list" "access_list" {
  for_each   = toset(var.allowed_cidr_blocks)
  project_id = mongodbatlas_project.project.id
  cidr_block = each.value
  comment    = "Hyperflix Platform Access - Managed by Terraform"
}

resource "mongodbatlas_database_user" "app_user" {
  username           = var.app_username
  password           = local.final_app_password
  project_id         = mongodbatlas_project.project.id
  auth_database_name = "admin"

  roles {
    role_name     = "readWrite"
    database_name = var.database_name
  }

  roles {
    role_name     = "read"
    database_name = "admin"
  }
}

resource "mongodbatlas_database_user" "reader_user" {
  username           = var.reader_username
  password           = local.final_reader_password
  project_id         = mongodbatlas_project.project.id
  auth_database_name = "admin"

  roles {
    role_name     = "read"
    database_name = var.database_name
  }
}

resource "local_file" "env_file" {
  filename        = "${path.module}/../.env.terraform"
  file_permission = "0600"
  content         = <<-EOT
# ========================================================
# Hyperflix Environment - Auto-generated by Terraform
# Cluster: ${mongodbatlas_advanced_cluster.cluster.name} (${var.cluster_tier} on ${var.cloud_provider})
# ========================================================
MONGO_URI=mongodb+srv://${var.app_username}:${local.final_app_password}@${local.srv_host}/
MONGO_DB_NAME=${var.database_name}
DATA_LAKE_ROOT=data_lake
MONGO_BATCH_SIZE=1000
MONGO_USER_COLLECTION=usuarios
MONGO_CONTENT_COLLECTIONS=peliculas,canales_tv
MONGO_SUBSCRIPTION_COLLECTION=suscripciones
MONGO_PAYMENT_COLLECTION=pagos
MONGO_EVENT_COLLECTION=reproducciones
DASHBOARD_OUTPUT_DIR=dashboard_output
DASHBOARD_SLA_MS=500
DASHBOARD_ATLAS_MONTHLY_COST=0
DASHBOARD_OPERATIONS_MONTHLY_COST=0
STREAMING_DB_NAME=${var.database_name}
STREAMING_WATCH_COLLECTIONS=reproducciones,suscripciones,pagos
STREAMING_TEMP_COLLECTION=streaming_cdc_demo
STREAMING_BATCH_SIZE=10
STREAMING_FLUSH_SECONDS=10
STREAMING_CHECKPOINT_PATH=data_lake/streaming/checkpoint.json
STREAMING_HIGH_PAYMENT_COP=500000
STREAMING_HIGH_PAYMENT_USD=15
STREAMING_SIMULTANEOUS_WINDOW_SECONDS=300
STREAMING_MARATHON_MINUTES=240
EOT
}
